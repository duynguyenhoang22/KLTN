{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vismishds.local/schema/dataset-v2.1-locked.json",
  "title": "ViSmishDS v2 record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id",
    "content",
    "label",
    "data_origin",
    "source",
    "message_domain",
    "sender_type",
    "surface_features",
    "target_audience",
    "obfuscation",
    "persuasion_tactics",
    "requested_actions",
    "annotation"
  ],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "content": {"type": "string", "minLength": 1},
    "label": {"type": "integer", "enum": [0, 1]},
    "data_origin": {
      "type": "string",
      "enum": ["real", "synthetic", "external_real", "external_curated"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "record_id"],
      "properties": {
        "dataset": {"type": "string", "minLength": 1},
        "file": {"type": ["string", "null"]},
        "record_id": {"type": "string", "minLength": 1}
      }
    },
    "message_domain": {
      "type": "string",
      "enum": [
        "banking_finance", "public_service", "telecom", "commerce",
        "logistics", "marketing_promotion", "employment", "investment",
        "debt_collection", "gambling", "adult_service", "healthcare",
        "personal_social", "other", "unknown"
      ]
    },
    "sender_type": {
      "type": "string",
      "enum": [
        "brandname", "shortcode", "personal_number", "not_applicable"
      ]
    },
    "surface_features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_url", "has_phone_number", "text_phenomena", "text_noise_score"
      ],
      "properties": {
        "has_url": {"type": "boolean"},
        "has_phone_number": {"type": "boolean"},
        "text_phenomena": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "none",
              "diacritic_omission", "abbreviation", "teencode",
              "character_substitution", "punctuation_insertion",
              "whitespace_splitting", "word_concatenation",
              "irregular_spacing", "irregular_casing", "character_repetition",
              "lang_switching", "natural_typo"
            ]
          }
        },
        "text_noise_score": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "target_audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["age_groups", "gender", "roles", "evidence"],
      "properties": {
        "age_groups": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "adolescent", "adult",
              "older_adult", "general", "unknown", "not_applicable"
            ]
          }
        },
        "gender": {
          "type": "string",
          "enum": ["female", "male", "all", "unknown"]
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "student", "job_seeker", "employee_or_worker",
              "business_owner", "customer", "debtor",
              "investor", "patient", "vehicle_owner",
              "retired_person", "general_public",
              "other", "unknown", "not_applicable"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "obfuscation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["present", "techniques", "severity", "confidence"],
      "properties": {
        "present": {"type": "boolean"},
        "techniques": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "character_substitution", "punctuation_insertion",
              "whitespace_splitting", "word_concatenation",
              "irregular_spacing", "irregular_casing", "character_repetition"
            ]
          }
        },
        "severity": {"type": "integer", "minimum": 0, "maximum": 4},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "persuasion_tactics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "none",
          "impersonation", "urgency", "fear", "authority",
          "reward_incentive", "social_proof", "scarcity", "threat",
          "credential_request", "payment_request", "link_lure",
          "off_platform_contact"
        ]
      }
    },
    "requested_actions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["types", "evidence"],
      "properties": {
        "types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "none", "click_or_visit_link", "call_phone", "reply_message",
              "provide_personal_information",
              "transfer_money", "make_payment", "deposit_or_top_up",
              "install_application", "contact_off_platform",
              "register_or_sign_up", "visit_physical_location", "other",
              "unclear"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "annotators", "confidence", "guideline_version",
        "taxonomy_version"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "unannotated", "auto_labeled", "human_reviewed", "adjudicated"
          ]
        },
        "annotators": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "guideline_version": {"type": "string", "minLength": 1},
        "taxonomy_version": {"type": "string", "minLength": 1},
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
